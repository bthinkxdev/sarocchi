# Django
DJANGO_SETTINGS_MODULE=yarn_guy.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://floward:floward@localhost:5432/yarn_guy

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 (optional)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-south-1
AWS_S3_CUSTOM_DOMAIN=

# Language
LANGUAGE_CODE=en

# Google OAuth
GOOGLE_CLIENT_ID=

# Accounts OTP
ACCOUNTS_OTP_EXPIRY_SECONDS=300
ACCOUNTS_OTP_MAX_ATTEMPTS=5
ACCOUNTS_GUEST_TOKEN_MAX_AGE=86400

# Cybersource
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SECRET_KEY=
CYBERSOURCE_RUN_ENVIRONMENT=apitest.cybersource.com

# Afterpay Direct
AFTERPAY_MERCHANT_ID=
AFTERPAY_SECRET_KEY=
AFTERPAY_ENVIRONMENT=global-api-sandbox.afterpay.com
AFTERPAY_CURRENCY=NZD
AFTERPAY_COUNTRY_CODE=NZ

